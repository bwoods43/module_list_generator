<?php
use Drupal\Core\StringTranslation\TranslatableMarkup;

/**
 * @file
 * Primary module hooks for Module list generator module.
 */

/**
 * Reads a custom block with by label and converts it into a PHP array.
 *
 * @param string $block_label
 *   Custom block label - currently being used only for 'Module list'
 *
 * @return array
 *   An associative array of module ids
 */
function module_list_generator_block_content_to_array($block_label) {
	$storage = \Drupal::entityTypeManager()->getStorage('block_content');

	$ids = $storage->getQuery()
  	->condition('info', $block_label)
  	->accessCheck(TRUE)
  	->execute();

	$module_list_array = [];
	if (!empty($ids)) {
  	$block_content = $storage->load(reset($ids));  
  	$body_value = $block_content->get('body')->value;
  	
  	// Actual block content should contain module ids, separated by lines/spaces, enclosed with paragraph tags (because it's in a regular body field, so we need to clean up that
		$clean = str_replace(["<p>", "</p>"], "", $body_value);
  	$module_list_array = explode(" ", $clean);
	}
	
	return $module_list_array;
}